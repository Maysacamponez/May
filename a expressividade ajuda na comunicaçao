const express = require('express')
const app = express()
app.use(express.urlencoded({ extended: true }))

app.get('/', (request, response) => {
    response.send('Envie os parâmetros n1 e n2 para as rotas /soma, /subtracao, /multiplicacao ou /divisao')
})

// Rota de Soma (já existente no exemplo)
app.get('/soma', (req, res) => {
    let n1 = parseFloat(req.query.n1)
    let n2 = parseFloat(req.query.n2)
    let result = n1 + n2
    
    if (isNaN(result)) {
        result = "Valores inválidos."
    } else {
        result = `${req.query.n1} +${req.query.n2} = ${result}` }  res.send({ conta: result }) })  // Nova Rota: Subtração app.get('/subtracao', (req, res) => { let n1 = parseFloat(req.query.n1) let n2 = parseFloat(req.query.n2) let result = n1 - n2  if (isNaN(result)) { result = "Valores inválidos." } else { result = `${req.query.n1} - ${req.query.n2} =${result}`
    }

